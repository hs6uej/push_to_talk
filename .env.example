# คัดลอกเป็น .env แล้วแก้ค่า
PTT_PORT=8090
# 127.0.0.1 = เข้าผ่าน nginx (HTTPS) เท่านั้น, 0.0.0.0 = เปิดตรง
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
MAX_TALK_SECONDS=60
# false = ปิดสมัครสมาชิกเอง (แอดมินสร้างบัญชีให้)
ALLOW_REGISTER=true
# ลบข้อความ/เสียง/เส้นทางที่เก่ากว่า N วัน (0 = เก็บตลอด)
RETENTION_DAYS=0
